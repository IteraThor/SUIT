{
  "manifest_version": 3,
  "name": "SUIT Kiosk Controls for Autodarts",
  "version": "1.1.0",
  "description": "In-page system power and session controls for Autodarts Kiosk mode.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.autodarts.com/*",
        "http://localhost:3180/*",
        "http://127.0.0.1:3180/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ]
}
